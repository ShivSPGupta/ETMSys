# ==========================================
# ETM System - Environment Configuration
# ==========================================

# --- Backend (server/.env) ---
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/orbit
# For MongoDB Atlas (replace credentials and cluster host):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# --- Frontend (client/.env) ---
# Local backend API endpoint:
VITE_API_URL=http://localhost:5000/api
# Deployed Vercel backend API endpoint:
# VITE_API_URL=https://<your-backend-deployment>.vercel.app/api

